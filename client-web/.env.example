# =============================================================================
# DomiClick landing (client-web) — plantilla (SÍ se sube a GitHub)
# Copia a client-web/.env y rellena. En Vercel pega estas mismas keys.
# =============================================================================

# Local: http://localhost:8787
# Prod:  https://TU-API.up.railway.app
VITE_DOMICLICK_API_URL=http://localhost:8787

# Mismo valor que DOMICLICK_INGEST_TOKEN en la API
VITE_DOMICLICK_INGEST_TOKEN=cambia-este-token-secreto
VITE_DOMICLICK_SITE_ID=clientes-landing

# Contacto Central (asistente / CTA)
VITE_DOMICLICK_WHATSAPP=57XXXXXXXXXX
VITE_DOMICLICK_PHONE=+57XXXXXXXXXX

# Firebase (opcional si usas firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Google Maps (mismo Map ID / estilo que Central ops)
VITE_GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_MAP_ID=7959bb6afa37dd5e9db669a8
