# =============================================================================
# DomiClick — plantilla (.env.example) — SÍ se sube a GitHub
# Copia a .env y rellena valores reales. Nunca commits de .env / .env.local
# =============================================================================

# Gemini (opcional)
GEMINI_API_KEY=

# ── Central ops (Vite raíz) ──────────────────────────────────────────────────
# Local: http://localhost:3000
# Prod:  https://domiclik-ops.vercel.app
APP_URL=http://localhost:3000

# ── Firebase DomiClik ────────────────────────────────────────────────────────
# Consola → Configuración del proyecto → General → Tus apps → SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Secreto del Client ID OAuth (Google Cloud → Credenciales). Solo servidor, nunca VITE_
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Google Maps Platform ─────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_PLATFORM_KEY=
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_MAP_ID=7959bb6afa37dd5e9db669a8

# ── API Tubo (server/) — Railway / Render / local ────────────────────────────
DOMICLICK_API_PORT=8787
PORT=8787
# Genera un token largo y úsalo IGUAL en API + landing
DOMICLICK_INGEST_TOKEN=cambia-este-token-secreto
DOMICLICK_AUTHORIZED_SITES=ventas-local,mi-tienda,clientes-landing

# URL pública o local de la API (ops + landing)
# Local: http://localhost:8787
# Prod:  https://TU-API.up.railway.app
VITE_DOMICLICK_API_URL=http://localhost:8787

# ── Landing clientes (copiar también a client-web/.env) ──────────────────────
VITE_DOMICLICK_INGEST_TOKEN=cambia-este-token-secreto
VITE_DOMICLICK_SITE_ID=clientes-landing
VITE_DOMICLICK_WHATSAPP=57XXXXXXXXXX
VITE_DOMICLICK_PHONE=+57XXXXXXXXXX

# ── Checklist Vercel (client-web) ────────────────────────────────────────────
# Root Directory: client-web
# Env: VITE_DOMICLICK_API_URL, VITE_DOMICLICK_INGEST_TOKEN, VITE_DOMICLICK_SITE_ID,
#      VITE_DOMICLICK_WHATSAPP, VITE_DOMICLICK_PHONE,
#      VITE_GOOGLE_MAPS_PLATFORM_KEY, VITE_GOOGLE_MAPS_MAP_ID
#      (+ VITE_FIREBASE_* si no usas firebase-applet-config.json)
#
# ── Checklist Railway/Render (API) ───────────────────────────────────────────
# Start: npx tsx server/index.ts
# Env: PORT, DOMICLICK_INGEST_TOKEN, DOMICLICK_AUTHORIZED_SITES, VITE_FIREBASE_*
#
# ── Firebase Auth domains ────────────────────────────────────────────────────
# localhost, domiclick.com, www.domiclick.com, ops.domiclick.com
# Deploy: npm run deploy:firebase  (ver docs/FIREBASE-DEPLOY.md)
